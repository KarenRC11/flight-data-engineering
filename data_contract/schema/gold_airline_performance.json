{
  "name": "airline_performance",
  "description": "Data contract for airline-level performance metrics.",
  "layer": "gold",
  "format": "Parquet",
  "columns": {
    "op_unique_carrier": {
      "type": "string",
      "required": true
    },
    "total_flights": {
      "type": "integer",
      "required": true
    },
    "cancelled_flights": {
      "type": "integer",
      "required": true
    },
    "diverted_flights": {
      "type": "integer",
      "required": true
    },
    "delayed_flights": {
      "type": "integer",
      "required": true
    },
    "avg_arr_delay": {
      "type": "numeric",
      "required": false,
      "description": "NULL when every flight of the carrier was cancelled or diverted (no arrival delay to average)."
    },
    "cancellation_rate": {
      "type": "numeric",
      "required": true
    },
    "delay_rate": {
      "type": "numeric",
      "required": true
    }
  }
}
